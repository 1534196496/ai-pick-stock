TZ=Asia/Shanghai
AIPICKSTOCK_ENVIRONMENT=development
AIPICKSTOCK_SESSION_LIFETIME_DAYS=30
AIPICKSTOCK_PUBLIC_WEB_URL=http://127.0.0.1:18080

POSTGRES_USER=aipickstock
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=aipickstock

AIPICKSTOCK_DATABASE_URL=postgresql+psycopg://aipickstock:replace-with-a-long-random-password@postgres:5432/aipickstock

# Worker 行情同步默认关闭显式联网；部署验收后再启用。
AIPICKSTOCK_MARKET_DATA_LIVE_ENABLED=false
AIPICKSTOCK_STOCK_REFRESH_SECONDS=60
AIPICKSTOCK_FUND_ESTIMATE_ENABLED=false

# production 环境必须配置容器可达的 SMTP，以下值仅为字段示例。
# AIPICKSTOCK_SMTP_HOST=smtp.example.com
# AIPICKSTOCK_SMTP_PORT=587
# AIPICKSTOCK_SMTP_USERNAME=replace-with-smtp-user
# AIPICKSTOCK_SMTP_PASSWORD=replace-with-smtp-password
# AIPICKSTOCK_SMTP_FROM_EMAIL=no-reply@example.com
# AIPICKSTOCK_SMTP_STARTTLS=true
