TZ=Asia/Shanghai
AIPICKSTOCK_ENVIRONMENT=development
AIPICKSTOCK_SESSION_LIFETIME_DAYS=30

POSTGRES_USER=aipickstock
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=aipickstock

AIPICKSTOCK_DATABASE_URL=postgresql+psycopg://aipickstock:replace-with-a-long-random-password@postgres:5432/aipickstock

# Worker 行情同步默认关闭显式联网；部署验收后再启用。
AIPICKSTOCK_MARKET_DATA_LIVE_ENABLED=false
AIPICKSTOCK_STOCK_REFRESH_SECONDS=60
AIPICKSTOCK_FUND_ESTIMATE_ENABLED=false
