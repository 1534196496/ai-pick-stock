TZ=Asia/Shanghai
AIPICKSTOCK_ENVIRONMENT=development
AIPICKSTOCK_SESSION_LIFETIME_DAYS=30
AIPICKSTOCK_PUBLIC_WEB_URL=http://127.0.0.1:18080

POSTGRES_USER=aipickstock
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=aipickstock

AIPICKSTOCK_DATABASE_URL=postgresql+psycopg://aipickstock:replace-with-a-long-random-password@postgres:5432/aipickstock

# Worker 行情同步默认关闭显式联网；部署验收后再启用。
AIPICKSTOCK_MARKET_DATA_LIVE_ENABLED=false
AIPICKSTOCK_STOCK_REFRESH_SECONDS=60
AIPICKSTOCK_FUND_ESTIMATE_ENABLED=false
AIPICKSTOCK_AI_PROVIDER=openai
# 模型服务与 Docker 部署在同一台服务器时使用：http://host.docker.internal:8080/v1
AIPICKSTOCK_AI_BASE_URL=https://api.openai.com/v1
AIPICKSTOCK_AI_API_KEY=
AIPICKSTOCK_AI_MODEL=
AIPICKSTOCK_AI_TIMEOUT_SECONDS=60
AIPICKSTOCK_AI_AGENT_ENABLED=true
AIPICKSTOCK_AI_AGENT_SKILL_ROOT=/app/agent_skills
AIPICKSTOCK_AI_AGENT_PROMPT_SPEC_PATH=/app/docs/ai-investment-analysis-prompt-spec.md
AIPICKSTOCK_AI_AGENT_WORKSPACE=/tmp/ai-pick-stock-agent
AIPICKSTOCK_AI_AGENT_REASONING_EFFORT=medium
AIPICKSTOCK_AI_AGENT_TURN_TIMEOUT_SECONDS=300
AIPICKSTOCK_AI_AGENT_MAX_CONCURRENCY=3
# 默认使用 openai-codex 自带的配套 Runtime；仅调试本机二进制时填写。
# AIPICKSTOCK_AI_AGENT_CODEX_BIN=/usr/local/bin/codex

# production 环境必须配置容器可达的 SMTP，以下值仅为字段示例。
# AIPICKSTOCK_SMTP_HOST=smtp.example.com
# AIPICKSTOCK_SMTP_PORT=587
# AIPICKSTOCK_SMTP_USERNAME=replace-with-smtp-user
# AIPICKSTOCK_SMTP_PASSWORD=replace-with-smtp-password
# AIPICKSTOCK_SMTP_FROM_EMAIL=no-reply@example.com
# AIPICKSTOCK_SMTP_STARTTLS=true
